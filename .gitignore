# colcon 构建产物（重新 build 即可生成，不应入库）
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo

# IDE / 编辑器
.vscode/
.idea/
*.swp

# 本机临时日志
*.log

# FAST-LIO 运行时产物（每次跑 fastlio_mapping 往源码目录里写日志/点云，动辄 MB 级）
src/fast_lio/Log/*.txt
src/fast_lio/PCD/
*.pcd
# 例外：3D 重定位用的先验地图是运行必需资产，随仓库提供。
!src/sam_bot_description/map/prior_3d_map.pcd

# Windows/WSL 复制文件产生的元数据（形如 foo:Zone.Identifier）
*Zone.Identifier*

# tf2/RViz 导出的 TF 框架图（运行时生成，非源码）
frames_*.gv
frames_*.pdf
