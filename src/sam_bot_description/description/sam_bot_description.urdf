<?xml version="1.0"?>
<!-- ============================================================
     机器人模型：由 OSURDF 导出的 CAD 模型（robot_1.urdf）改造而来。

     坐标系约定（重要）：
       CAD 模型的原生坐标是 X 横向、Y 前进、Z 朝上。
       ROS / Nav2 / 差速插件都要求 base_link 的 X 轴朝前、Y 轴朝左。
       因此这里新增了一个 base_link 作为根坐标系（X 朝前），再用固定关节
       chassis_joint（绕 Z 转 -90°）把 CAD 车体 base_chassis 挂到它下面。
       这样所有 CAD 关节/网格都随车体一起旋转，而外部看到的 base_link 仍是
       标准 ROS 朝向。

     坐标系链：
       map -> odom -> base_link -> base_chassis -> 车轮/万向轮
                                  -> livox -> livox_imu
                                  -> camera_link -> camera_depth_frame
       - odom -> base_link 由 FAST-LIO 发布（源码里已改成这个 frame 名）
       - 其余由 robot_state_publisher 根据本文件发布

     地面高度：驱动轮中心在 base_chassis 系 z=-0.14，轮半径 0.10，
     所以车轮最低点在 base_link 系 z=-0.24，base_footprint 放在该高度。
     生成实体时用 spawn_entity 的 -z 0.25 让轮子刚好落在地面上。
     ============================================================ -->
<robot name="sam_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find mid360_simulation)/urdf/mid360.xacro"/>

  <!-- ============================================================
       1. 标准 ROS 根坐标系与地面投影
       ============================================================ -->
  <link name="base_link"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       2. CAD 车体（原 base_link，重命名为 base_chassis）
          visual 使用 STL（已删除 CAD 自带的 Mid-360 本体，保留 z=0.80~0.84
          的安装底座板，雷达由下面的 mid360 宏提供）；collision 改用简单
          几何体：base_link.STL 有 70 多万个三角面，用网格做碰撞会让 ODE 极慢。
       ============================================================ -->
  <link name="base_chassis">
    <inertial>
      <origin xyz="0.0010635236612118078 -0.15863769177604597 0.1457305423837727" rpy="0 0 0" />
      <mass value="28.110476308334977" />
      <inertia ixx="2.6673293985065456" ixy="0.0080117654261472136" ixz="0.0064824190420816547" iyy="1.7644197278940936" iyz="0.24978382008723846" izz="2.0476428359771264" />
    </inertial>

    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/base_link.STL" />
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.82352999999999998 0.82352999999999998 1 1" />
      </material>
    </visual>

    <!-- 下部车身：覆盖 z≈-0.16~0.2 的主体 -->
    <collision name="collision_lower">
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.64 1.00 0.34" />
      </geometry>
    </collision>
    <!-- 上部车身：避免上半部分直接穿过墙壁/障碍 -->
    <collision name="collision_upper">
      <origin xyz="0 0 0.50" rpy="0 0 0" />
      <geometry>
        <box size="0.60 0.95 0.60" />
      </geometry>
    </collision>
  </link>

  <!-- CAD 车体相对 base_link 绕 Z 转 -90°，把模型的 +Y(前) 转到 base_link 的 +X(前) -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_chassis"/>
    <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- ============================================================
       3. 驱动轮（原 new_link / new_link_1，后轴，轴线沿 CAD X）
          旋转后其在 base_link 下的轴线为 -Y，为了让差速插件“正速度=前进”
          的约定成立，这里把轴线取反为 -X。
       ============================================================ -->
  <link name="new_link">
    <inertial>
      <origin xyz="-0.052434184741920686 1.6531918659357103E-05 -1.4726384853780417E-06" rpy="0 0 0" />
      <mass value="2.147148742527679" />
      <inertia ixx="0.0099743487597354439" ixy="-1.5123717227879389E-06" ixz="-3.0802864155377773E-07" iyy="0.0067262388033097892" iyz="-2.2614753004310536E-08" izz="0.0067266398008904195" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <!-- STL 在轮轴方向的包络是 x∈[-0.1025, 0.1540]，圆柱要跟着偏移，
           否则碰撞体比视觉轮子更靠外/靠内，倒车时容易“挂”住。 -->
      <origin xyz="0.02575 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.10" length="0.2565" />
      </geometry>
    </collision>
  </link>

  <joint name="new_joint" type="continuous">
    <parent link="base_chassis" />
    <child link="new_link" />
    <origin xyz="-0.2397 -0.32184000000000001 -0.14000000000000001" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="20" velocity="20" />
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="new_link_1">
    <inertial>
      <origin xyz="0.052434184741920631 -1.6531918659357103E-05 -1.4726384853780417E-06" rpy="0 0 0" />
      <mass value="2.147148742527679" />
      <inertia ixx="0.0099743487597354474" ixy="-1.5123717227888187E-06" ixz="3.0802864155377779E-07" iyy="0.0067262388033097927" iyz="2.2614753004310625E-08" izz="0.0067266398008904195" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link_1.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <origin xyz="-0.02575 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.10" length="0.2565" />
      </geometry>
    </collision>
  </link>

  <joint name="new_link_1_joint" type="continuous">
    <parent link="base_chassis" />
    <child link="new_link_1" />
    <origin xyz="0.24129999999999999 -0.32184000000000001 -0.14000000000000001" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="20" velocity="20" />
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- ============================================================
       4. 前部两个万向轮（转向支架 + 小轮，均为被动关节）
       ============================================================ -->
  <link name="new_link_2">
    <inertial>
      <origin xyz="1.9449851012182107E-05 4.4075970130341702E-06 0.019499999999999629" rpy="0 0 0" />
      <mass value="0.062626548245743874" />
      <inertia ixx="4.107638669573145E-05" ixy="1.9748937124731317E-20" ixz="-1.5652382009012757E-21" iyy="4.1076386695729356E-05" iyz="9.3601205964401085E-20" izz="8.1484756876839545E-05" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link_2.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <origin xyz="0 0 -0.02225" rpy="0 0 0" />
      <geometry>
        <box size="0.106 0.091 0.092" />
      </geometry>
    </collision>
  </link>

  <joint name="new_link_2_joint" type="continuous">
    <parent link="base_chassis" />
    <child link="new_link_2" />
    <origin xyz="-0.20921999999999999 0.26816000000000001 -0.1575" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="10" />
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <link name="new_link_3">
    <inertial>
      <origin xyz="0.017399972173346157 2.0071589057479855E-08 -3.6062317576579517E-09" rpy="0 0 0" />
      <mass value="0.16202650006261154" />
      <inertia ixx="0.00011991196961979824" ixy="-8.9317794712541859E-11" ixz="1.4011838950084868E-12" iyy="7.4904630662427093E-05" iyz="3.0828011208726721E-12" izz="7.4903671540581861E-05" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link_3.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <origin xyz="0.0175 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.04" length="0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="new_link_3_joint" type="continuous">
    <parent link="new_link_2" />
    <child link="new_link_3" />
    <origin xyz="-0.017381000000000001 0.030003999999999999 -0.040500000000000001" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="1" velocity="20" />
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <link name="new_link_4">
    <inertial>
      <origin xyz="1.9449851012209862E-05 4.4075970131451925E-06 0.019499999999999629" rpy="0 0 0" />
      <mass value="0.062626548245743888" />
      <inertia ixx="4.1076386695731457E-05" ixy="2.0149602733936687E-20" ixz="-1.5652382009012742E-21" iyy="4.1076386695729343E-05" iyz="9.3601205964401073E-20" izz="8.1484756876839545E-05" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link_4.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <origin xyz="0 0 -0.02225" rpy="0 0 0" />
      <geometry>
        <box size="0.106 0.091 0.092" />
      </geometry>
    </collision>
  </link>

  <joint name="new_link_4_joint" type="continuous">
    <parent link="base_chassis" />
    <child link="new_link_4" />
    <origin xyz="0.21078 0.26816000000000001 -0.1595" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="10" />
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <link name="new_link_5">
    <inertial>
      <origin xyz="-0.01750002782665383 2.0071588058279133E-08 -0.0020000036062219895" rpy="0 0 0" />
      <mass value="0.16202650006261154" />
      <inertia ixx="0.00011991196961979824" ixy="-8.9317794712541859E-11" ixz="1.4011838950084868E-12" iyy="7.4904630662427093E-05" iyz="3.0828011209243709E-12" izz="7.4903671540581861E-05" />
    </inertial>
    <visual name="visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find sam_bot_description)/meshes/visual/new_link_5.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision name="collision_0">
      <origin xyz="-0.0175 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.04" length="0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="new_link_5_joint" type="continuous">
    <parent link="new_link_4" />
    <child link="new_link_5" />
    <origin xyz="0.017519 0.030003999999999999 -0.0385" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="1" velocity="20" />
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- ============================================================
       5. Gazebo 摩擦参数
          驱动轮要有抓地力；万向轮摩擦小，避免转向时拖拽。
       ============================================================ -->
  <gazebo reference="new_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="new_link_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="new_link_3">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="new_link_5">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <!-- ============================================================
       6. 差速驱动插件
          驱动轮中心间距 = 0.2397 + 0.2413 = 0.481 m
          轮直径 = 0.20 m（STL 包络 0.2 x 0.2）
          publish_odom_tf=false：odom->base_link 由 FAST-LIO 发布，避免 TF 冲突
       ============================================================ -->
  <gazebo>
    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <ros>
        <namespace>/demo</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
      </ros>

      <left_joint>new_joint</left_joint>
      <right_joint>new_link_1_joint</right_joint>

      <wheel_separation>0.481</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>

      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 把 6 个关节的真实角度发布到 /joint_states，供 robot_state_publisher 更新车轮 TF -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>new_joint</joint_name>
      <joint_name>new_link_1_joint</joint_name>
      <joint_name>new_link_2_joint</joint_name>
      <joint_name>new_link_3_joint</joint_name>
      <joint_name>new_link_4_joint</joint_name>
      <joint_name>new_link_5_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============================================================
       7. Livox Mid-360（3D 点云 + 内置 IMU）
          CAD 网格里原本画了一个 Mid-360（z=0.84~0.915 的部件），已从
          base_link.STL 中删除，只保留 z=0.80~0.84 的安装底座板。这里改用
          mid360.xacro 的仿真雷达替换，安装位置与角度都和原 CAD 雷达一致：
          CAD 坐标 (x≈0.0008, y≈0.3235) → base_link (0.3235, 0, ...)。
          实测 CAD 网格里雷达装在一个 30° 斜面上（斜面法向量 (0, ±0.5, ±0.866)，
          绕车体横向轴前倾），即雷达本体朝前进方向前倾 30°。base_link 前进方向
          是 +x，故 pitch 取 +30°（rpy 的 pitch 项 ${pi/6}）。
          宏的可视网格相对 link 原点下沉 0.045 m，倾斜以网格底面为支点：
          底面落在底座板 z=0.84、水平中心 x=0.3235 处不动，网格向上前倾 30°。
          注意：这里只倾斜「可视网格」（visual_rpy），livox link 本身以及
          雷达/IMU 坐标系仍保持水平。原因：FAST-LIO 的 IMU 姿态以初始水平
          为基准、且默认 IMU 与 base_link 对齐；若把 link/IMU 一起倾斜 30°，
          odom→base_link 会在运动时严重发散（实测 pitch 漂到 60°），导致
          AMCL 失定位、Nav2 陷入 recovery 原地旋转。因此保留水平雷达/IMU
          坐标系，仅让外观与 CAD 的 30° 斜装一致，导航管线照常工作。
          向下波束会打到 z≈0.845 的底座板，pointcloud_to_laserscan 的
          max_height=0.80 能滤掉这些自身回波，同时保留墙面点（墙顶对应
          base_link z=0.76）。
       ============================================================ -->
  <xacro:mid360 name="livox" parent="base_link" visual_rpy="0 ${pi/6} 0">
    <origin xyz="0.3235 0 0.885"/>
  </xacro:mid360>

  <!-- ============================================================
       8. 深度相机（保留原项目功能，装在车头前上方）
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.130 0.022"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.130 0.022"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- 装在车头下部前脸（CAD 前缘在 base_link x≈0.54），朝前看 -->
    <origin xyz="0.50 0 0.30" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth">
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera name="camera">
        <horizontal_fov>1.047198</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3</far>
        </clip>
      </camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <frame_name>camera_depth_frame</frame_name>
        <pointCloudCutoff>0.5</pointCloudCutoff>
        <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>
